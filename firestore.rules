rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    
    // Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if request user ID matches document ID or owner field
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Get current user role from custom claims or user profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isLegalPro() {
      return hasRole('LEGAL_PRO');
    }

    function isCustomer() {
      return hasRole('CUSTOMER');
    }


    // ===== COLLECTION RULES =====

    // 1. BASE USERS COLLECTION (/users/{userId})
    match /users/{userId} {
      // User can read & update their own profile; Admin can read/write any
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. CUSTOMER PROFILES (/customers/{userId})
    match /customers/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isLegalPro() || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // 3. LEGAL PROFESSIONAL PROFILES (/professionals/{userId})
    match /professionals/{userId} {
      // Verified legal pro profiles are publicly viewable
      allow read: if resource.data.isVerified == true || (isAuthenticated() && (isOwner(userId) || isAdmin()));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // 4. BOOKINGS (/bookings/{bookingId})
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. CONSULTATION NOTES & CASE FILES (/consultation_notes/{noteId})
    match /consultation_notes/{noteId} {
      // Accessible ONLY by assigned legal professional, admin, or customer if explicitly shared
      allow read: if isAuthenticated() && (
        resource.data.professionalId == request.auth.uid ||
        (resource.data.customerId == request.auth.uid && resource.data.isSharedWithCustomer == true) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        (isLegalPro() && request.resource.data.professionalId == request.auth.uid) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (isLegalPro() && resource.data.professionalId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (isLegalPro() && resource.data.professionalId == request.auth.uid) ||
        isAdmin()
      );
    }

    // 6. LEGAL SERVICES CATALOG (/legal_services/{serviceId})
    match /legal_services/{serviceId} {
      allow read: if true; // Public catalog
      allow write: if isAuthenticated() && (isLegalPro() || isAdmin());
    }

    // 7. INSIGHTS & ARTICLES (/insights/{articleId})
    match /insights/{articleId} {
      allow read: if resource.data.isPublished == true || (isAuthenticated() && (isLegalPro() || isAdmin()));
      allow write: if isAuthenticated() && (isLegalPro() || isAdmin());
    }

    // 8. FAQS (/faqs/{faqId})
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
