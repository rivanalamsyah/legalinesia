# Legalinesia Firebase Client Environment Configuration Example
# DO NOT place private keys, service account JSONs, or secret tokens here.
# Client credentials below are public Web SDK identifiers. Security is enforced by Firestore Security Rules.

FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=legalinesia-demo.firebaseapp.com
FIREBASE_PROJECT_ID=legalinesia-demo
FIREBASE_STORAGE_BUCKET=legalinesia-demo.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Firebase Emulator Settings (set to true for local development with emulator)
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
